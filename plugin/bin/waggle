#!/bin/sh
# Launcher: runs the waggle client installed on this machine. If it is missing, fetches the
# build for this platform once and checks it against the SHA-256 list shipped in this
# plugin (bin/SHA256SUMS, written by tools/release.sh), so a tampered download never runs.
exe=""; case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) exe=".exe";; esac  # Git Bash on Windows
BIN="${WAGGLE_BIN:-$HOME/.waggle/bin/waggle$exe}"
if [ -x "$BIN" ]; then exec "$BIN" "$@"; fi
here="$(cd "$(dirname "$0")" && pwd)"
URL="${WAGGLE_RELEASE_URL:-$(cat "$here/RELEASE_URL" 2>/dev/null)}"
fetch() {
  [ -n "$URL" ] && [ -f "$here/SHA256SUMS" ] || return 1
  os="$(uname -s | tr 'A-Z' 'a-z')"; arch="$(uname -m)"
  case "$os" in mingw*|msys*|cygwin*) os=windows;; esac
  case "$arch" in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) return 1;; esac
  file="waggle-$os-$arch$exe"; want="$(awk -v f="$file" '$2==f {print $1}' "$here/SHA256SUMS")"
  [ -n "$want" ] || return 1
  mkdir -p "$(dirname "$BIN")" && curl -fsSL --max-time 60 "$URL/$file" -o "$BIN.dl" || return 1
  if command -v sha256sum >/dev/null 2>&1; then got="$(sha256sum "$BIN.dl" | awk '{print $1}')"; else got="$(shasum -a 256 "$BIN.dl" | awk '{print $1}')"; fi
  [ "$want" = "$got" ] || { rm -f "$BIN.dl"; return 1; }
  chmod +x "$BIN.dl" && mv "$BIN.dl" "$BIN"
}
if fetch; then exec "$BIN" "$@"; fi
case "$1" in
  hook) [ "$2" = start ] && echo "[waggle] the waggle client is not installed on this machine and could not be fetched. A person installs it (see the waggle install page), then restarts the session."; exit 0 ;;
  *) echo "waggle: client not installed ($BIN missing) and it could not be fetched." >&2; exit 127 ;;
esac
